<script>
// Highlight the nav link for the section on screen
const links=[...document.querySelectorAll('.nav a.link')];
const byId=Object.fromEntries(links.map(a=>[a.getAttribute('href').slice(1),a]));
const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){links.forEach(l=>l.classList.remove('active')); byId[e.target.id]?.classList.add('active')}})},{rootMargin:'-45% 0px -50% 0px'});
Object.keys(byId).forEach(id=>{const s=document.getElementById(id); if(s) io.observe(s)});

// Photo viewer (gallery photos and Design Work projects)
const lb=document.querySelector('.lightbox'), lbImg=lb.querySelector('img'), lbCap=lb.querySelector('.lb-cap');
const prevB=lb.querySelector('.lb-prev'), nextB=lb.querySelector('.lb-next');
let list=[], cur=0, opener=null;
function show(i){cur=(i+list.length)%list.length; const it=list[cur]; lbImg.src=it.src(); lbImg.alt=it.alt; lbCap.textContent=it.cap+(list.length>1?`  ·  ${cur+1} of ${list.length}`:'')}
function openViewer(items,i,btn){list=items; opener=btn; prevB.hidden=nextB.hidden=items.length<2; show(i); lb.showModal()}
const item=(im,cap)=>({src:()=>im.currentSrc||im.src, alt:im.alt, cap:cap||''});
const shots=[...document.querySelectorAll('.shot')];
const shotItems=shots.map(b=>item(b.querySelector('img'),b.dataset.cap));
shots.forEach((b,i)=>b.addEventListener('click',()=>openViewer(shotItems,i,b)));
document.querySelectorAll('.project').forEach(p=>{const items=[...p.querySelectorAll('img')].map(im=>item(im,im.dataset.cap)); p.addEventListener('click',()=>openViewer(items,0,p))});
lb.querySelector('.lb-close').onclick=()=>lb.close();
prevB.onclick=()=>show(cur-1);
nextB.onclick=()=>show(cur+1);
lb.addEventListener('click',e=>{if(e.target===lb||e.target.classList.contains('lb-inner'))lb.close()});
lb.addEventListener('keydown',e=>{if(list.length>1&&e.key==='ArrowLeft')show(cur-1); if(list.length>1&&e.key==='ArrowRight')show(cur+1)});
lb.addEventListener('close',()=>opener&&opener.focus());

// Copy email to clipboard instead of opening a mail app
document.querySelectorAll('.copy-email').forEach(b=>b.addEventListener('click',async()=>{
  const email=b.dataset.email, hint=b.querySelector('.copy-hint');
  try{await navigator.clipboard.writeText(email)}
  catch{const t=document.createElement('textarea'); t.value=email; document.body.appendChild(t); t.select(); document.execCommand('copy'); t.remove()}
  hint.textContent='Copied!'; setTimeout(()=>hint.textContent='Copy',2000);
}));
</script>
</body>
</html>
