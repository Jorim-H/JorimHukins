<style>
/* ===== Design tokens: change colors and fonts here ===== */
:root{
  --cream:#F6F1E9; --sand:#E8DDCC; --espresso:#2E241D; --brown:#8B6F55; --clay:#B4693E;
  --bg:var(--cream); --panel:var(--sand); --ink:var(--espresso); --muted:var(--brown); --accent:var(--clay);
  --line:rgba(46,36,29,.14);
  --font-display:"Bricolage Grotesque", "Arial Narrow", Arial, sans-serif;
  --font-body:Karla, "Helvetica Neue", Arial, sans-serif;
  --nav-h:56px; --wrap:1180px;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
/* Light theme only, on purpose: every visitor sees the same design, whatever their device setting */
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth; scroll-padding-top:calc(var(--nav-h) + env(safe-area-inset-top,0px))}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0; background:var(--bg); color:var(--ink); font-family:var(--font-body); font-size:1.125rem; line-height:1.6; -webkit-font-smoothing:antialiased}
img{max-width:100%; display:block}
a{color:inherit}
:focus-visible{outline:2px solid var(--accent); outline-offset:3px}
.wrap{max-width:var(--wrap); margin:0 auto; padding:0 clamp(20px,5vw,48px)}
h1,h2,h3{font-family:var(--font-display); font-weight:700; line-height:1.05; margin:0; letter-spacing:-.01em}

/* Placeholder marker: delete class="tbd" once the text is final */
.tbd{outline:1.5px dashed var(--accent); outline-offset:5px; border-radius:2px}

/* ===== Navigation: sticky, takes its own space, never covers content ===== */
body::before{content:""; position:fixed; inset:0 0 auto; height:env(safe-area-inset-top,0px); background:var(--bg); z-index:10}
.nav{position:sticky; top:env(safe-area-inset-top,0px); z-index:9; height:var(--nav-h); background:var(--bg); border-bottom:1px solid var(--line)}
.nav .wrap{height:100%; display:flex; align-items:center; justify-content:space-between; gap:24px}
.nav .name{font-family:var(--font-display); font-weight:700; font-size:1.1rem; text-decoration:none; white-space:nowrap}
.nav ul{list-style:none; margin:0; padding:0; display:flex; gap:clamp(14px,2.4vw,30px); overflow-x:auto; scrollbar-width:none}
.nav ul::-webkit-scrollbar{display:none}
.nav a.link{font-size:.95rem; text-decoration:none; color:var(--muted); white-space:nowrap; padding:6px 0; border-bottom:2px solid transparent; transition:color .2s,border-color .2s}
.nav a.link:hover{color:var(--ink)}
.nav a.link.active{color:var(--ink); border-bottom-color:var(--accent)}
@media (max-width:640px){.nav .name{display:none} .nav .wrap{justify-content:flex-start} .nav ul{-webkit-mask-image:linear-gradient(90deg,#000 85%,transparent); mask-image:linear-gradient(90deg,#000 85%,transparent); padding-right:24px}}

/* ===== Landing ===== */
.hero{position:relative; height:calc(100svh - var(--nav-h) - env(safe-area-inset-top,0px)); min-height:460px; max-height:920px; overflow:hidden}
.hero img{width:100%; height:100%; object-fit:cover; object-position:50% 60%}
.hero .copy{position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-start; padding-top:clamp(32px,7vh,90px); color:#2E241D}
.hero h1{font-size:clamp(3rem,7.5vw,6.5rem); font-weight:800; letter-spacing:-.035em; line-height:.92; text-wrap:balance}
.hero p{font-size:clamp(1.15rem,2.2vw,1.6rem); margin:22px 0 0; max-width:30ch; line-height:1.35}

/* ===== Shared section spacing ===== */
section{padding:clamp(72px,11vw,140px) 0}
.section-head{max-width:46rem; margin-bottom:clamp(36px,5vw,56px)}
.section-head h2{font-size:clamp(2.2rem,5.5vw,3.8rem)}
.section-head p{color:var(--muted); margin:14px 0 0; font-size:1.2rem}

/* ===== About ===== */
.about-grid{display:grid; grid-template-columns:minmax(200px,340px) 1fr; gap:clamp(32px,6vw,80px); align-items:center}
.about-grid img{width:100%; aspect-ratio:1; object-fit:cover; border-radius:6px}
.about-grid h2{font-size:clamp(2rem,4.5vw,3.2rem); margin-bottom:20px}
.about-grid p{margin:0; max-width:60ch}
@media (max-width:760px){.about-grid{grid-template-columns:1fr} .about-grid img{max-width:300px}}

/* ===== Through My Lens ===== */
#lens{background:var(--panel)}
.set{margin-top:clamp(48px,7vw,88px)}
.set:first-of-type{margin-top:0}
.set h3{font-size:1.5rem; margin-bottom:22px; display:flex; align-items:baseline; gap:14px}
.set h3 span{font-family:var(--font-body); font-weight:400; font-size:1rem; color:var(--muted)}
.gallery{columns:3 280px; column-gap:14px}
.shot{display:block; width:100%; margin:0 0 14px; padding:0; border:0; background:none; cursor:zoom-in; break-inside:avoid; border-radius:4px; overflow:hidden}
.shot img{width:100%; height:auto; max-height:520px; object-fit:cover; transition:transform .5s ease}
.shot:hover img{transform:scale(1.025)}
@media (prefers-reduced-motion:reduce){.shot img{transition:none}}

/* ===== Lightbox ===== */
dialog.lightbox{border:0; padding:0; max-width:none; max-height:none; width:100vw; height:100dvh; background:rgba(20,15,12,.94); color:#F1E8DA}
dialog.lightbox::backdrop{background:transparent}
.lb-inner{height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:calc(env(safe-area-inset-top,0px) + 56px) 64px calc(env(safe-area-inset-bottom,0px) + 24px)}
.lb-inner img{max-width:100%; max-height:calc(100% - 48px); object-fit:contain}
.lb-cap{margin-top:14px; font-size:1rem; opacity:.85; white-space:pre}
.lb-btn{position:absolute; background:none; border:0; color:inherit; font-size:2rem; line-height:1; padding:12px 16px; cursor:pointer; opacity:.8}
.lb-btn:hover{opacity:1}
.lb-close{top:calc(env(safe-area-inset-top,0px) + 8px); right:12px}
.lb-prev{left:6px; top:50%; transform:translateY(-50%)}
.lb-next{right:6px; top:50%; transform:translateY(-50%)}
@media (max-width:640px){.lb-inner{padding-left:12px; padding-right:12px} .lb-prev,.lb-next{top:auto; bottom:calc(env(safe-area-inset-bottom,0px) + 8px); transform:none}}

/* ===== Things I've Made ===== */
.made{display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:clamp(28px,4vw,48px)}
.made-slot{aspect-ratio:4/3; border:1.5px dashed var(--line); border-radius:6px; display:grid; place-items:center; color:var(--muted); font-size:1rem; text-align:center; padding:20px; background:var(--panel)}
.project{position:relative; display:block; width:100%; aspect-ratio:4/3; padding:0; border:1px solid var(--line); border-radius:6px; overflow:hidden; background:var(--panel); cursor:zoom-in; font:inherit; color:inherit; transition:border-color .2s}
.project:hover{border-color:var(--accent)}
.project.row{display:grid; grid-template-columns:repeat(4,1fr); gap:8px; padding:18px 14px; align-items:center}
.project.row img{width:100%; height:auto; border-radius:3px; box-shadow:0 2px 8px rgba(46,36,29,.2)}
.project.frame{display:flex; flex-direction:column; background:var(--bg)}
.project.frame .bar{flex:none; height:24px; display:flex; align-items:center; gap:6px; padding:0 10px; background:var(--panel); border-bottom:1px solid var(--line)}
.project.frame .bar i{width:8px; height:8px; border-radius:50%; background:var(--muted); opacity:.45}
.project.frame img{flex:1; min-height:0; width:100%; object-fit:cover; object-position:top}
.project.frame img:not(:first-of-type){display:none}
.project.frame img.cover-left{object-position:left top}
.badge{position:absolute; right:10px; bottom:10px; background:var(--ink); color:var(--bg); font-size:.8rem; font-weight:600; padding:4px 11px; border-radius:999px}
.made h3{font-size:1.5rem; margin:20px 0 8px}
.made p{margin:0; color:var(--muted); max-width:46ch}

/* ===== How I Work ===== */
#how{border-top:1px solid var(--line)}
.how-intro{max-width:44rem; font-size:1.25rem; margin:0 0 clamp(40px,6vw,64px)}
.principles{display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:clamp(28px,4vw,48px)}
.principles > div{background:var(--sand); border-top:3px solid var(--accent); padding:22px 22px 24px; border-radius:6px; box-shadow:0 6px 18px rgba(46,36,29,.10)}
.principles h3{font-size:1.35rem; margin-bottom:10px}
.principles p{margin:0; color:var(--muted)}
.how-note{margin:clamp(36px,5vw,56px) 0 0; color:var(--muted)}
.how-note a{color:var(--ink); text-decoration-color:var(--accent); text-underline-offset:3px}
.example{margin-top:clamp(48px,7vw,80px); padding:24px 28px; background:var(--sand); border-left:3px solid var(--accent); border-radius:6px; box-shadow:0 6px 18px rgba(46,36,29,.10); max-width:46rem}
.example h3{font-size:1.35rem; margin-bottom:10px}
.example p{margin:0}

/* ===== Contact ===== */
#contact{background:var(--panel)}
#contact h2{font-size:clamp(2.6rem,7vw,5rem)}
#contact p{max-width:44ch; font-size:1.25rem; margin:20px 0 32px}
.btn{display:inline-block; background:var(--ink); color:var(--bg); text-decoration:none; font-weight:600; padding:14px 26px; border-radius:999px; transition:background .2s}
.btn:hover{background:var(--accent)}
button.btn{border:0; font:inherit; font-weight:600; cursor:pointer}
.copy-hint{margin-left:12px; padding-left:12px; border-left:1px solid currentColor; font-weight:400; opacity:.75}
.contact-links{display:flex; flex-wrap:wrap; gap:14px; margin-top:32px}
.btn-ghost{background:transparent; color:var(--ink); border:1.5px solid var(--ink); padding:12.5px 24.5px}
.btn-ghost:hover{background:var(--ink); color:var(--bg)}
footer{padding:28px 0; font-size:.95rem; color:var(--muted)}
footer .wrap{display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px}
</style>
</head>
